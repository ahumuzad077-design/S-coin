# Public Expo client configuration. These values are embedded in the app bundle.
# Never put exchange, aggregator, database, or private credentials here.
EXPO_PUBLIC_SCOIN_API_URL=http://127.0.0.1:8787
EXPO_PUBLIC_SCOIN_CHAIN_ID=
EXPO_PUBLIC_SWAP_API_URL=
EXPO_PUBLIC_SCOIN_DAPP_URL=
# Optional JSON object of EVM chain IDs to trusted HTTPS RPC URLs.
# Defaults include Ethereum, Sepolia, Polygon, Optimism, Arbitrum, Base and BNB Chain.
EXPO_PUBLIC_METAMASK_SUPPORTED_NETWORKS_JSON=

# Native EVM sends are staged on Sepolia only by default. Add mainnet IDs deliberately after review.
EXPO_PUBLIC_EVM_TRANSFER_CHAIN_IDS=0xaa36a7

# EVM swaps are disabled unless the quote server and client build both explicitly enable them.
# 0x supports selected production EVM networks; it is not a Sepolia testnet swap venue.
EXPO_PUBLIC_EVM_SWAP_ENABLED=false
# Decimal EVM chain IDs; leave blank until exact configuration and review are complete.
EXPO_PUBLIC_EVM_SWAP_CHAIN_IDS=
# Per-chain trust list: {"1":{"transactionTargets":["0x..."],"allowanceTargets":["0x..."]}}
EXPO_PUBLIC_EVM_SWAP_TARGETS_JSON={}

# Native S Coin transfers require the exact chain ID, trusted CometBFT RPC and approved fee policy.
# Default stays OFF until the chain operator supplies and verifies these values.
EXPO_PUBLIC_SCOIN_COSMOS_SEND_ENABLED=false
EXPO_PUBLIC_SCOIN_RPC_URL=
EXPO_PUBLIC_SCOIN_GAS_PRICE=

# Optional S Coin securities and Sentinel service URLs (public HTTPS URLs only).
EXPO_PUBLIC_SENTINEL_DASHBOARD_URL=
EXPO_PUBLIC_MERIDIAN_ISSUER_PORTAL_URL=
