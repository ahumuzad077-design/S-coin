# Public Expo client configuration. These values are embedded in the app bundle.
# Never put exchange, aggregator, database, or private credentials here.
EXPO_PUBLIC_SCOIN_API_URL=http://127.0.0.1:8787
EXPO_PUBLIC_SCOIN_CHAIN_ID=
EXPO_PUBLIC_SWAP_API_URL=
EXPO_PUBLIC_SCOIN_DAPP_URL=
# Optional JSON object of EVM chain IDs to trusted HTTPS RPC URLs.
# Defaults include Ethereum, Sepolia, Polygon, Optimism, Arbitrum, Base and BNB Chain.
EXPO_PUBLIC_METAMASK_SUPPORTED_NETWORKS_JSON=

# Native EVM sends are staged on Sepolia only by default. Add mainnet IDs deliberately after review.
EXPO_PUBLIC_EVM_TRANSFER_CHAIN_IDS=0xaa36a7
