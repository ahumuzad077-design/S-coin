# Required long random server-side token for Sentinel dashboard/API access.
# Generate at least 32 random bytes; never expose this in an Expo EXPO_PUBLIC_ variable.
SENTINEL_API_TOKEN=replace-with-a-long-random-secret
SENTINEL_COOKIE_SECURE=true

# Paper trading is mandatory unless BOTH this and ALPACA_PAPER_TRADE=false are set.
SENTINEL_LIVE_TRADING_ENABLED=false
ALPACA_PAPER_TRADE=true

# Alpaca / model provider credentials; store in your hosting provider's secret manager.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=

# Optional runtime settings.
PORT=5000
AUTO_START=false
